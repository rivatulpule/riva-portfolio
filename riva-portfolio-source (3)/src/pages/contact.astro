---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeButton from '../components/ResumeButton.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Riva Tulpule about consumer insights, brand strategy, and customer experience opportunities."
>
  <section class="mx-auto max-w-2xl px-5 py-16 sm:px-8 sm:py-24">
    <p class="font-serif-display text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-rust)]">
      Contact
    </p>
    <h1 class="mt-2 font-serif-display text-4xl font-semibold text-[var(--color-charcoal)] sm:text-5xl">
      Let's connect.
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink)]/85">
      I'd love to hear from you if you want to talk consumer insights, brand strategy, or an opportunity you think
      I'd be a good fit for.
    </p>

    <div class="mt-10 space-y-5">
      <div class="flex items-center gap-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-paper)] p-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6 shrink-0 text-[var(--color-brown)]" aria-hidden="true">
          <path d="M3 7l9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
        </svg>
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-brown)]">Email</p>
          <a href="mailto:rtulpule@usc.edu" class="link-underline text-lg font-medium text-[var(--color-charcoal)]">
            rtulpule@usc.edu
          </a>
        </div>
      </div>

      <div class="flex items-center gap-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-paper)] p-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6 shrink-0 text-[var(--color-brown)]" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6ZM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
        </svg>
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-brown)]">LinkedIn</p>
          <a
            href="https://www.linkedin.com/in/rivatulpule/"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline text-lg font-medium text-[var(--color-charcoal)]"
          >
            linkedin.com/in/rivatulpule
          </a>
        </div>
      </div>

      <div class="flex items-center gap-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-paper)] p-5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6 shrink-0 text-[var(--color-brown)]" aria-hidden="true">
          <path d="M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm2 4h6M9 11h6M9 15h4" />
        </svg>
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-brown)]">Resume</p>
          <div class="mt-1">
            <ResumeButton />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
