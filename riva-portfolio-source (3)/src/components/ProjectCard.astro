---
import Placeholder from './Placeholder.astro';

interface Props {
  slug: string;
  title: string;
  subtitle: string;
  projectType: string;
  category: string[];
  summary: string;
  coverImage: string;
  coverImageAlt: string;
  featured?: boolean;
}

const {
  slug,
  title,
  subtitle,
  projectType,
  category,
  summary,
  coverImage,
  coverImageAlt,
  featured = false,
} = Astro.props;

const isPlaceholder = coverImage.includes('placeholder');
---

<a
  href={`/work/${slug}`}
  class={`group flex flex-col overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-paper)] transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-border-strong)] hover:shadow-[0_12px_24px_-8px_rgba(37,43,43,0.16)] ${
    featured ? 'sm:col-span-1' : ''
  }`}
  data-categories={category.join('|')}
>
  <div class="overflow-hidden">
    {isPlaceholder ? (
      <Placeholder label={coverImageAlt} aspect="video" class="transition-transform duration-500 group-hover:scale-[1.03]" />
    ) : (
      <img
        src={coverImage}
        alt={coverImageAlt}
        loading="lazy"
        class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    )}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-6">
    <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-rust)]">{projectType}</span>
    <h3 class="font-serif-display text-xl font-semibold leading-snug text-[var(--color-charcoal)]">
      {title}
    </h3>
    <p class="text-sm italic text-[var(--color-brown)]">{subtitle}</p>
    <p class="text-sm leading-relaxed text-[var(--color-ink)]/85">{summary}</p>
    <span class="link-underline mt-auto inline-flex w-fit items-center gap-1 pt-2 text-sm font-semibold text-[var(--color-brown)]">
      Read the case study
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </div>
</a>
