---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DecodeCard from '../../components/DecodeCard.astro';
import { getCollection } from 'astro:content';

const editions = (await getCollection('decode', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.number - a.data.number
);
---

<BaseLayout
  title="Decode"
  description="Decode: The Why Behind The Buy — Riva Tulpule's original series unpacking the psychology behind the brands we love and the choices we make."
>
  <section class="border-b border-[var(--color-border)] bg-[var(--color-cream-dark)]">
    <div class="mx-auto max-w-3xl px-5 py-16 text-center sm:px-8 sm:py-20">
      <p class="font-serif-display text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-rust)]">
        An original series
      </p>
      <h1 class="mt-3 font-serif-display text-4xl font-semibold text-[var(--color-charcoal)] sm:text-5xl">
        Decode: The Why Behind The Buy
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-[var(--color-ink)]/85">
        I've always been fascinated by the invisible forces that shape the choices we make every day. Why do some
        brands become impossible to forget? Why do we choose certain products over others? Why do some experiences
        stay with us long after they're over?
      </p>
      <p class="mt-4 text-lg leading-relaxed text-[var(--color-ink)]/85">
        Decode is my attempt to explore those stories — unpacking the brands we love, the choices we make, and the
        experiences that shape us through the lens of consumer behavior and strategy. Because the most interesting
        insights often start with a simple question: <span class="italic text-[var(--color-brown)]">why?</span>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8 sm:py-20">
    <h2 class="font-serif-display text-2xl font-semibold text-[var(--color-charcoal)]">Archive</h2>
    <div class="mt-8 grid grid-cols-1 gap-5">
      {editions.map((edition) => (
        <DecodeCard
          slug={edition.id}
          number={edition.data.number}
          title={edition.data.title}
          topic={edition.data.topic}
          summary={edition.data.summary}
          coverImage={edition.data.coverImage}
          coverImageAlt={edition.data.coverImageAlt}
        />
      ))}
    </div>
  </section>
</BaseLayout>
