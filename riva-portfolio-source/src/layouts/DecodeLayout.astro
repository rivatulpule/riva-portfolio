---
import BaseLayout from './BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';

interface AdjacentEdition {
  slug: string;
  number: number;
  title: string;
}

interface Props {
  number: number;
  title: string;
  topic: string;
  summary: string;
  publishDate: Date;
  linkedinUrl?: string;
  coverImage: string;
  coverImageAlt: string;
  next?: AdjacentEdition;
}

const { number, title, topic, summary, publishDate, linkedinUrl, coverImage, coverImageAlt, next } = Astro.props;
const isPlaceholder = coverImage.includes('placeholder');
const paddedNumber = String(number).padStart(3, '0');

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`Decode ${paddedNumber}: ${title}`} description={summary}>
  <article>
    <header class="border-b border-[var(--color-border)] bg-[var(--color-cream-dark)]">
      <div class="mx-auto max-w-3xl px-5 pb-12 pt-14 sm:px-8 sm:pt-20">
        <a href="/decode" class="link-underline text-sm font-semibold text-[var(--color-brown)]">← Back to Decode</a>

        <p class="mt-6 font-serif-display text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-rust)]">
          Decode {paddedNumber} · The Why Behind The Buy
        </p>
        <h1 class="mt-3 font-serif-display text-4xl font-semibold leading-tight text-[var(--color-charcoal)] sm:text-5xl">
          {title}
        </h1>
        <p class="mt-3 text-lg italic text-[var(--color-brown)]">{topic}</p>
        <p class="mt-4 text-sm font-medium text-[var(--color-ink)]/70">{formattedDate}</p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-5 py-10 sm:px-8">
      {isPlaceholder ? (
        <Placeholder label={coverImageAlt} aspect="wide" class="mb-10" />
      ) : (
        <img src={coverImage} alt={coverImageAlt} class="mb-10 aspect-[16/9] w-full rounded-lg object-cover" />
      )}

      <div
        class="prose prose-neutral max-w-none prose-headings:font-serif-display prose-headings:font-semibold prose-headings:text-[var(--color-charcoal)] prose-p:leading-relaxed prose-p:text-[var(--color-ink)]/90 prose-a:text-[var(--color-brown)] prose-a:font-semibold prose-strong:text-[var(--color-charcoal)] prose-blockquote:border-[var(--color-rust)] prose-blockquote:text-[var(--color-brown-dark)] prose-lg"
      >
        <slot />
      </div>

      {linkedinUrl ? (
        <a
          href={linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-flex items-center gap-2 rounded-full border border-[var(--color-brown)] px-5 py-2.5 text-sm font-semibold text-[var(--color-brown)] transition-colors hover:bg-[var(--color-brown)] hover:text-[var(--color-cream)]"
        >
          View the original post on LinkedIn
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      ) : (
        <p class="mt-10 rounded-md border border-dashed border-[var(--color-border-strong)] bg-[var(--color-cream-dark)] px-4 py-3 text-sm italic text-[var(--color-brown)]">
          Editable note — add the link to this edition's original LinkedIn post here.
        </p>
      )}
    </div>

    {next && (
      <footer class="border-t border-[var(--color-border)] bg-[var(--color-cream-dark)]">
        <div class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-4 px-5 py-10 sm:flex-row sm:items-center sm:px-8">
          <p class="text-sm font-medium uppercase tracking-wide text-[var(--color-brown)]">Next edition</p>
          <a href={`/decode/${next.slug}`} class="group flex items-center gap-3 font-serif-display text-xl font-semibold text-[var(--color-charcoal)]">
            Decode {String(next.number).padStart(3, '0')}: {next.title}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5 transition-transform group-hover:translate-x-1">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </footer>
    )}
  </article>
</BaseLayout>
