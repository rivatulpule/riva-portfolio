---
import BaseLayout from './BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';

interface NextProject {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  subtitle: string;
  projectType: string;
  category: string[];
  summary: string;
  coverImage: string;
  coverImageAlt: string;
  next: NextProject;
}

const { title, subtitle, projectType, category, summary, coverImage, coverImageAlt, next } = Astro.props;
const isPlaceholder = coverImage.includes('placeholder');
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="border-b border-[var(--color-border)] bg-[var(--color-cream-dark)]">
      <div class="mx-auto max-w-4xl px-5 pb-12 pt-14 sm:px-8 sm:pt-20">
        <a href="/work" class="link-underline text-sm font-semibold text-[var(--color-brown)]">← Back to Work</a>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-[var(--color-border-strong)] bg-[var(--color-paper)] px-3 py-1 text-xs font-semibold uppercase tracking-wide text-[var(--color-rust)]">
            {projectType}
          </span>
          {category.map((c) => (
            <span class="rounded-full border border-[var(--color-border)] px-3 py-1 text-xs font-medium text-[var(--color-brown)]">
              {c}
            </span>
          ))}
        </div>

        <h1 class="mt-5 max-w-3xl font-serif-display text-4xl font-semibold leading-tight text-[var(--color-charcoal)] sm:text-5xl">
          {title}
        </h1>
        <p class="mt-3 max-w-2xl text-lg italic text-[var(--color-brown)]">{subtitle}</p>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-[var(--color-ink)]/90">{summary}</p>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-5 py-10 sm:px-8">
      {isPlaceholder ? (
        <Placeholder label={coverImageAlt} aspect="wide" class="mb-10" />
      ) : (
        <img src={coverImage} alt={coverImageAlt} class="mb-10 aspect-[16/9] w-full rounded-lg object-cover" />
      )}

      <div
        class="prose prose-neutral max-w-none prose-headings:font-serif-display prose-headings:font-semibold prose-headings:text-[var(--color-charcoal)] prose-h2:mt-12 prose-h2:text-2xl prose-h2:border-t prose-h2:border-[var(--color-border)] prose-h2:pt-8 prose-p:leading-relaxed prose-p:text-[var(--color-ink)]/90 prose-a:text-[var(--color-brown)] prose-a:font-semibold prose-strong:text-[var(--color-charcoal)] prose-li:text-[var(--color-ink)]/90 prose-blockquote:border-[var(--color-rust)] prose-blockquote:text-[var(--color-brown-dark)]"
      >
        <slot />
      </div>
    </div>

    <footer class="border-t border-[var(--color-border)] bg-[var(--color-cream-dark)]">
      <div class="mx-auto flex max-w-4xl flex-col items-start justify-between gap-4 px-5 py-10 sm:flex-row sm:items-center sm:px-8">
        <p class="text-sm font-medium uppercase tracking-wide text-[var(--color-brown)]">Next project</p>
        <a href={`/work/${next.slug}`} class="group flex items-center gap-3 font-serif-display text-xl font-semibold text-[var(--color-charcoal)]">
          {next.title}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
