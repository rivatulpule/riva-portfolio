---
import ResumeButton from './ResumeButton.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/decode', label: 'Decode' },
  { href: '/leadership', label: 'Leadership & Impact' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-cream)]/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a href="/" class="font-serif-display text-xl font-semibold tracking-tight text-[var(--color-charcoal)]">
      Riva Tulpule
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`link-underline text-sm font-medium tracking-wide transition-colors ${
            isActive(link.href) ? 'text-[var(--color-brown)]' : 'text-[var(--color-charcoal)] hover:text-[var(--color-brown)]'
          }`}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <ResumeButton />
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center rounded-md border border-[var(--color-border)] p-2 text-[var(--color-charcoal)] lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-6 w-6">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="hidden h-6 w-6">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-[var(--color-border)] bg-[var(--color-cream)] px-5 pb-5 pt-2 lg:hidden"
    aria-label="Mobile"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`rounded-md px-2 py-3 text-base font-medium ${
          isActive(link.href) ? 'text-[var(--color-brown)]' : 'text-[var(--color-charcoal)]'
        }`}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
    <div class="mt-2">
      <ResumeButton />
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('flex');
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });

  // Close mobile menu when a link is clicked (helps SPA-like feel on same-page anchors)
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
