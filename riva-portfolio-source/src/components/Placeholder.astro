---
// A clearly-labeled placeholder used anywhere a real photo, screenshot, or
// visual deliverable is still needed. Swap this component out for a real
// <img> tag once you have the asset (see README.md "Adding real images").
interface Props {
  label: string; // what should eventually go here, e.g. "Headshot" or "Market visit photo, Al Ghurair store audit"
  aspect?: 'square' | 'video' | 'portrait' | 'wide';
  class?: string;
}

const { label, aspect = 'video', class: className = '' } = Astro.props;

const aspectClass = {
  square: 'aspect-square',
  video: 'aspect-[4/3]',
  portrait: 'aspect-[3/4]',
  wide: 'aspect-[16/9]',
}[aspect];
---

<div
  class={`placeholder-block ${aspectClass} ${className} flex w-full flex-col items-center justify-center gap-2 border border-dashed border-[var(--color-border-strong)] bg-[var(--color-cream-dark)] p-6 text-center`}
  role="img"
  aria-label={`Placeholder image: ${label}`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    class="h-8 w-8 text-[var(--color-brown)] opacity-60"
    aria-hidden="true"
  >
    <rect x="3" y="3" width="18" height="18" rx="1.5" />
    <circle cx="8.5" cy="9" r="1.5" />
    <path d="m21 15-5-5-11 11" />
  </svg>
  <p class="max-w-[24ch] text-xs font-medium uppercase tracking-wide text-[var(--color-brown)] opacity-80">
    Image needed: {label}
  </p>
</div>
