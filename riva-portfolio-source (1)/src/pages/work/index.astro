---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = [
  'All',
  'Professional & Client Work',
  'Consumer Insights',
  'Customer Experience',
  'Brand Strategy',
] as const;
---

<BaseLayout
  title="Work"
  description="Case studies in consumer insights, customer experience, and brand strategy — professional client work and independent concepts by Riva Tulpule."
>
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="font-serif-display text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-rust)]">Work</p>
    <h1 class="mt-2 max-w-2xl font-serif-display text-4xl font-semibold text-[var(--color-charcoal)] sm:text-5xl">
      Research, strategy, and a few ideas I couldn't stop thinking about.
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--color-ink)]/85">
      A mix of professional client work, academic projects, and independent concepts — each clearly labeled so
      you know exactly what you're looking at.
    </p>

    <!-- Filters -->
    <div id="filters" class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projects by category">
      {categories.map((cat, i) => (
        <button
          type="button"
          class:list={[
            'filter-btn rounded-full border px-4 py-2 text-sm font-medium transition-colors',
            i === 0
              ? 'border-[var(--color-brown)] bg-[var(--color-brown)] text-[var(--color-cream)]'
              : 'border-[var(--color-border-strong)] bg-[var(--color-paper)] text-[var(--color-charcoal)] hover:border-[var(--color-brown)]',
          ]}
          data-category={cat}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </div>

    <div id="project-grid" class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {allWork.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          subtitle={project.data.subtitle}
          projectType={project.data.projectType}
          category={project.data.category}
          summary={project.data.summary}
          coverImage={project.data.coverImage}
          coverImageAlt={project.data.coverImageAlt}
        />
      ))}
    </div>

    <p id="empty-state" class="mt-10 hidden text-center text-sm text-[var(--color-ink)]/60">
      No projects in this category yet.
    </p>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('#project-grid > a');
  const emptyState = document.getElementById('empty-state');

  function applyFilter(category: string) {
    let visibleCount = 0;
    cards.forEach((card) => {
      const cats = (card.dataset.categories || '').split('|');
      const show = category === 'All' || cats.includes(category);
      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });
    emptyState?.classList.toggle('hidden', visibleCount !== 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('border-[var(--color-brown)]', 'bg-[var(--color-brown)]', 'text-[var(--color-cream)]');
        b.classList.add('border-[var(--color-border-strong)]', 'bg-[var(--color-paper)]', 'text-[var(--color-charcoal)]');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('border-[var(--color-brown)]', 'bg-[var(--color-brown)]', 'text-[var(--color-cream)]');
      btn.classList.remove('border-[var(--color-border-strong)]', 'bg-[var(--color-paper)]', 'text-[var(--color-charcoal)]');
      btn.setAttribute('aria-pressed', 'true');
      applyFilter(btn.dataset.category || 'All');
    });
  });
</script>
