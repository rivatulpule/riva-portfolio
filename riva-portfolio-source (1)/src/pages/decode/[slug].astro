---
import { getCollection, render } from 'astro:content';
import DecodeLayout from '../../layouts/DecodeLayout.astro';

export async function getStaticPaths() {
  const editions = (await getCollection('decode', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.number - b.data.number
  );

  return editions.map((edition, index) => {
    const nextEdition = editions[index + 1]; // undefined for the last (most recent) edition
    return {
      params: { slug: edition.id },
      props: {
        edition,
        next: nextEdition
          ? { slug: nextEdition.id, number: nextEdition.data.number, title: nextEdition.data.title }
          : undefined,
      },
    };
  });
}

const { edition, next } = Astro.props;
const { Content } = await render(edition);
---

<DecodeLayout
  number={edition.data.number}
  title={edition.data.title}
  topic={edition.data.topic}
  summary={edition.data.summary}
  publishDate={edition.data.publishDate}
  linkedinUrl={edition.data.linkedinUrl}
  coverImage={edition.data.coverImage}
  coverImageAlt={edition.data.coverImageAlt}
  next={next}
>
  <Content />
</DecodeLayout>
