---
import Placeholder from './Placeholder.astro';

interface Props {
  slug: string;
  number: number;
  title: string;
  topic: string;
  summary: string;
  coverImage: string;
  coverImageAlt: string;
}

const { slug, number, title, topic, summary, coverImage, coverImageAlt } = Astro.props;
const isPlaceholder = coverImage.includes('placeholder');
const paddedNumber = String(number).padStart(3, '0');
---

<a
  href={`/decode/${slug}`}
  class="group grid grid-cols-1 gap-5 overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-paper)] p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-[var(--color-border-strong)] hover:shadow-[0_12px_24px_-8px_rgba(37,43,43,0.16)] sm:grid-cols-[minmax(0,180px)_1fr] sm:p-6"
>
  <div class="overflow-hidden rounded-md">
    {isPlaceholder ? (
      <Placeholder label={coverImageAlt} aspect="square" />
    ) : (
      <img
        src={coverImage}
        alt={coverImageAlt}
        loading="lazy"
        class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      />
    )}
  </div>
  <div class="flex flex-col justify-center gap-2">
    <span class="font-serif-display text-sm font-semibold tracking-wide text-[var(--color-rust)]">
      Decode {paddedNumber}
    </span>
    <h3 class="font-serif-display text-xl font-semibold leading-snug text-[var(--color-charcoal)] sm:text-2xl">
      {title}
    </h3>
    <p class="text-sm italic text-[var(--color-brown)]">{topic}</p>
    <p class="text-sm leading-relaxed text-[var(--color-ink)]/85">{summary}</p>
    <span class="link-underline mt-1 inline-flex w-fit items-center gap-1 text-sm font-semibold text-[var(--color-brown)]">
      Read this edition
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3.5 w-3.5">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </div>
</a>
